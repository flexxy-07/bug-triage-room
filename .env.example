# =================================================================
# Bug Triage Room Environment Variables
# =================================================================

# Google AI Studio Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Target Repository Configuration
# Absolute path to your local clone of Mem-CLI
TARGET_REPO=E:/GenAI/Projects/Mem-CLI
TARGET_RUN_CMD=memcli

# Switch Agent Protocol Configuration (for digest agent)
SWITCH_SERVER_URL=http://localhost:3000
SWITCH_ROOM_NAME=bug-triage
SWITCH_AGENT_NAME=digest
SWITCH_AGENT_TOKEN=optional_token_if_configured

